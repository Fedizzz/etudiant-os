# Copier en .env pour le développement local (fichier ignoré par Git). Ne jamais y mettre la clé service_role / secret.
# URL et clé PUBLIQUE (anon / publishable) du projet Supabase : Dashboard → Project Settings → API.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre-cle-publique
# Chemin de base du site (GitHub Pages : /etudiant-os/ ; domaine propre : /)
BASE_PATH=/etudiant-os/
SITE_URL=https://fedizzz.github.io/etudiant-os/
# 1 seulement si le fournisseur Google est configuré dans Supabase
GOOGLE_AUTH=0
