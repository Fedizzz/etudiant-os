{
  "name": "etudiant-os",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Étudiant.OS — planning, focus, budget, courses, ménage et sommeil pour étudiants.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && node scripts/serve.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types tests/core.test.ts tests/sync.test.ts tests/router.test.ts",
    "test:db": "node --test --experimental-strip-types tests/db.test.ts",
    "test:e2e": "node tests/e2e.mjs"
  },
  "engines": { "node": ">=22.6" },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "esbuild": "0.21.5",
    "playwright-core": "1.47.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.4.5"
  }
}
